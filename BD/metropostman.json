    {
      "name": "Login Admin",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin1\",\n  \"password\": \"admin\"\n}"
        },
        "url": "{{baseUrl}}/dbproj/user"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.test('login admin ok', function () { pm.expect(data.status).to.eql(200); });",
              "pm.collectionVariables.set('adminToken', data.results);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
