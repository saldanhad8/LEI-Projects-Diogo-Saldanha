    {
      "name": "10. Purchase Ticket",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const d = new Date();",
              "d.setDate(d.getDate() + 1);",
              "const yyyy = d.getFullYear();",
              "const mm = String(d.getMonth() + 1).padStart(2, '0');",
              "const dd = String(d.getDate()).padStart(2, '0');",
              "pm.collectionVariables.set('travelDate', `${yyyy}-${mm}-${dd}`);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.test('purchase ok', function () { pm.expect(data.status).to.eql(200); });",
              "if (data.results && data.results.purchase_id) {",
              "  pm.collectionVariables.set('purchaseId', data.results.purchase_id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{customerToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"line_id\": 2,\n  \"product_type\": \"single_trip\",\n  \"travel_date\": \"{{travelDate}}\"\n}"
        },
        "url": "{{baseUrl}}/dbproj/purchase"
      }
